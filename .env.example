# Convex — populated automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk auth — create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk JWT issuer domain (Clerk dashboard > JWT Templates > convex template > Issuer)
CLERK_JWT_ISSUER_DOMAIN=

# Point Clerk at this app's own embedded sign-in/up pages instead of its hosted
# Account Portal (accounts.<domain>) — the portal subdomain isn't set up in DNS.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AssemblyAI transcription
ASSEMBLYAI_API_KEY=

# MCP server auth — per-user tokens live in Convex (mcpTokens table), generated from Settings.
MCP_SHARED_SECRET=
